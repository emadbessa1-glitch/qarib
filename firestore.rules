rules_version = '2';

// قواعد الأمان لقاعدة بيانات "قريب".
// انشرها من Firebase Console ← Firestore ← Rules، أو: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // الأدمن = أي إيميل ليه document في collection اسمه admins (اسم الـ document هو الإيميل بحروف صغيرة).
    // تضيف أدمن أو تشيله من Firebase Console من غير ما تعدّل الكود.
    function isAdmin() {
      return signedIn()
          && request.auth.token.email is string
          && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    // كل أدمن يقدر يقرا الـ document بتاعه بس (عشان التطبيق يعرف إنه أدمن).
    // الإضافة والحذف من Firebase Console بس.
    match /admins/{adminEmail} {
      allow read: if signedIn()
                  && request.auth.token.email is string
                  && request.auth.token.email.lower() == adminEmail;
      allow write: if false;
    }

    // بيانات المستخدمين: كل مستخدم يكتب ويقرا بياناته بس، والأدمن يقرا الكل.
    match /users/{uid} {
      allow create, update: if signedIn()
                            && request.auth.uid == uid
                            // الرقم لازم يكون محجوز لنفس الحساب (رقم واحد لكل نوع حساب)
                            && getAfter(/databases/$(database)/documents/phoneClaims/$(request.resource.data.role + '_' + request.resource.data.phone)).data.uid == request.auth.uid
                            && request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'role', 'createdAt'])
                            && request.resource.data.role in ['user', 'business']
                            && request.resource.data.name is string
                            && request.resource.data.name.size() >= 2
                            && request.resource.data.name.size() <= 60
                            && request.resource.data.phone is string
                            && request.resource.data.phone.matches('^0[0-9]{7,10}$')
                            && request.resource.data.email is string
                            && request.resource.data.email.size() <= 100
                            && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$');
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      // الأدمن، أو المستخدم بيمسح حسابه.
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // حجز الأرقام: كل رقم موبايل بيتسجل مرة واحدة كمستخدم ومرة واحدة كصاحب عمل.
    // الاسم: role_phone (مثلاً user_01012345678).
    match /phoneClaims/{claimId} {
      allow read: if isAdmin()
                  || (signedIn() && (resource == null || resource.data.uid == request.auth.uid));
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['uid', 'role', 'phone'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.role in ['user', 'business']
                    && request.resource.data.phone.matches('^0[0-9]{7,10}$')
                    && claimId == request.resource.data.role + '_' + request.resource.data.phone;
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // البلاغات: أي حد مسجل يبلّغ، والأدمن بس يشوف ويقفل.
    match /reports/{reportId} {
      allow create: if signedIn()
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.keys().hasOnly(['target', 'reason', 'reporterId', 'createdAt',
                                                             'placeId', 'chatId', 'itemId', 'reportedUserId', 'excerpt'])
                    && request.resource.data.target in ['review', 'message', 'chat', 'place']
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() <= 100
                    && request.resource.data.excerpt.size() <= 500;
      allow read, delete: if isAdmin();
    }

    match /places/{placeId} {
      // الناس بتشوف المتوافق عليه بس. الأدمن بيشوف كله. صاحب المكان بيشوف مكانه.
      allow read: if resource.data.status == 'approved'
                  || isAdmin()
                  || (signedIn() && resource.data.ownerId == request.auth.uid);

      // صاحب عمل مسجل بس يقدر يضيف مكان، وبيتسجل pending ومن غير تقييمات.
      allow create: if signedIn()
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'business'
                    && request.resource.data.status == 'pending'
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.ratingSum == 0
                    && request.resource.data.ratingCount == 0
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 100;

      // الأدمن يعدّل أي حاجة. غيره يقدر يزوّد عداد التقييم بس (تقييم واحد في المرة، من 1 لـ 5).
      allow update: if isAdmin()
                    // صاحب المكان يفعّل أو يقفل الواتساب بس.
                    || (signedIn()
                        && resource.data.ownerId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['whatsapp'])
                        && request.resource.data.whatsapp is string
                        && request.resource.data.whatsapp.size() <= 15)
                    || (signedIn()
                        && resource.data.status == 'approved'
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['ratingSum', 'ratingCount'])
                        && request.resource.data.ratingCount == resource.data.ratingCount + 1
                        && request.resource.data.ratingSum >= resource.data.ratingSum + 1
                        && request.resource.data.ratingSum <= resource.data.ratingSum + 5);

      allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if signedIn()
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.rating is int
                      && request.resource.data.rating >= 1
                      && request.resource.data.rating <= 5
                      && request.resource.data.comment.size() <= 300;
        allow update, delete: if isAdmin();
      }
    }

    // الشات: المستخدم وصاحب المكان بس يشوفوا المحادثة ويكتبوا فيها.
    // بتتفتح بس مع مكان متوافق عليه ومقفول فيه الواتساب.
    function isParticipant(chat) {
      return signedIn()
          && (request.auth.uid == chat.userId || request.auth.uid == chat.ownerId);
    }

    match /chats/{chatId} {
      // resource == null عشان التطبيق يقدر يعرف إن المحادثة لسه مش موجودة.
      allow read: if resource == null || isParticipant(resource.data);

      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && chatId == request.resource.data.placeId + '_' + request.auth.uid
                    && request.resource.data.ownerId != request.auth.uid
                    && request.resource.data.get('blockedBy', null) == null
                    && request.resource.data.ownerId ==
                         get(/databases/$(database)/documents/places/$(request.resource.data.placeId)).data.ownerId
                    && get(/databases/$(database)/documents/places/$(request.resource.data.placeId)).data.status == 'approved'
                    && get(/databases/$(database)/documents/places/$(request.resource.data.placeId)).data.whatsapp == '';

      allow update: if isParticipant(resource.data)
                    && (
                      // رسالة جديدة (ومش محظورة)
                      (request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['lastMessage', 'lastSenderId', 'updatedAt'])
                       && request.resource.data.lastSenderId == request.auth.uid
                       && resource.data.get('blockedBy', null) == null)
                      // حظر من أي طرف، وفك الحظر من اللي حظر بس
                      || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blockedBy'])
                          && ((resource.data.get('blockedBy', null) == null
                               && request.resource.data.blockedBy == request.auth.uid)
                              || (resource.data.get('blockedBy', null) == request.auth.uid
                                  && request.resource.data.blockedBy == null)))
                    );

      match /messages/{messageId} {
        allow read: if isParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data);
        allow create: if isParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data)
                      && get(/databases/$(database)/documents/chats/$(chatId)).data.get('blockedBy', null) == null
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 1000;
        // الأدمن بيمسح رسالة اتبلّغ عنها.
        allow delete: if isAdmin();
      }
    }
  }
}
